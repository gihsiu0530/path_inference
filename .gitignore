__pycache__/
*.zip
*.ckpt
# Model weights, same reasoning as *.ckpt: model/depth_anything_v2_vitl.pth is
# 1.3 GB and is fetched/copied, not authored here.
*.pth
*.png
*.jpg
*.npy
*.csv
*.bag
.vscode/
# Ignore dataset payloads, but keep the pipeline scripts the README documents.
# Must use dataset/** (not dataset/): a directory-form rule stops git from
# descending, which would make the negations below unreachable.
dataset/**
!dataset/**/
!dataset/**/*.py

# real_time_ff: track code only. Weights, third-party model repos, local
# workspace copies, experiment scratch and plot output stay out of git.
real_time_ff/model/
real_time_ff/TwinLiteNet/
real_time_ff/time/
real_time_ff/move/
real_time_ff/imgs/
real_time_ff/record/
real_time_ff/漸進修正/
real_time_ff/**/*copy*
real_time_ff/**/*(copy)*
